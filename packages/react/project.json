{
  "name": "@ks-digital/designsystem-react",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/react/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "dependsOn": [
        {
          "target": "build",
          "projects": ["@ks-digital/designsystem-themes"]
        }
      ]
    },
    "storybook": {
      "options": {
        "port": 4403,
        "config-dir": ".storybook"
      },
      "configurations": {
        "ci": {
          "args": ["--quiet"]
        }
      }
    },
    "build-storybook": {
      "dependsOn": ["@ks-digital/designsystem-themes:build"],
      "outputs": ["{projectRoot}/{options.output-dir}"],
      "options": {
        "config-dir": ".storybook",
        "output-dir": "../../dist/storybook/@ks-digital/designsystem-react"
      },
      "configurations": {
        "ci": {
          "args": ["--quiet"]
        }
      }
    },
    "static-storybook": {
      "executor": "@nx/web:file-server",
      "dependsOn": ["build-storybook"],
      "options": {
        "buildTarget": "@ks-digital/designsystem-react:build-storybook",
        "staticFilePath": "dist/storybook/@ks-digital/designsystem-react",
        "spa": true
      },
      "configurations": {
        "ci": {
          "buildTarget": "@ks-digital/designsystem-react:build-storybook:ci"
        }
      }
    }
  }
}
