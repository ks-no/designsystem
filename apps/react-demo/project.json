{
  "name": "react-demo",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/react-demo/src",
  "projectType": "application",
  "tags": [],
  "// targets": "to see all targets run: nx show project react-demo --web",
  "targets": {
    "build": {
      "dependsOn": [
        {
          "target": "build",
          "projects": ["@ks-digital/designsystem-themes"]
        }
      ],
      "outputs": ["{workspaceRoot}/dist/apps/react-demo"]
    },
    "serve": {
      "dependsOn": [
        {
          "target": "build",
          "projects": ["@ks-digital/designsystem-themes"]
        }
      ]
    },
    "serve-static": {
      "options": {
        "buildTarget": "build",
        "staticFilePath": "dist/apps/react-demo",
        "spa": true
      }
    }
  }
}
