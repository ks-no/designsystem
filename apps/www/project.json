{
  "name": "www",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/www/.storybook",
  "tags": [],
  "targets": {
    "storybook": {
      "options": {
        "port": 4402,
        "config-dir": ".storybook"
      },
      "configurations": {
        "ci": {
          "args": ["--quiet"]
        }
      }
    },
    "build-storybook": {
      "dependsOn": [
        "@ks-digital/designsystem-angular:build-storybook",
        "@ks-digital/designsystem-react:build-storybook",
        "@ks-digital/designsystem-web:build-storybook"
      ],
      "outputs": ["{projectRoot}/{options.output-dir}"],
      "options": {
        "config-dir": ".storybook",
        "output-dir": "../../dist/storybook/@ks-digital/www"
      },
      "configurations": {
        "ci": {
          "args": ["--quiet"]
        }
      }
    },
    "assemble-storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/storybook/assemble.mjs"
      }
    },
    "static-storybook": {
      "executor": "@nx/web:file-server",
      "dependsOn": ["assemble-storybook"],
      "options": {
        "buildTarget": "www:assemble-storybook",
        "staticFilePath": "dist/storybook/@ks-digital/assembled",
        "spa": false
      },
      "configurations": {
        "ci": {
          "buildTarget": "www:build-storybook:ci"
        }
      }
    },
    "storybook-all": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "nx run-many -t storybook --parallel=3 -p @ks-digital/designsystem-angular @ks-digital/designsystem-react @ks-digital/designsystem-web",
          "until curl -s http://localhost:4400 > /dev/null && curl -s http://localhost:4401 > /dev/null && curl -s http://localhost:4403 > /dev/null; do sleep 1; done && nx run www:storybook"
        ],
        "parallel": true
      }
    }
  }
}
