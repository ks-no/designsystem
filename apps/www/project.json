{
  "name": "www",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/www/.storybook",
  "tags": [],
  "targets": {
    "storybook": {
      "options": {
        "port": 4402,
        "config-dir": ".storybook"
      },
      "configurations": {
        "ci": {
          "args": ["--quiet"]
        }
      }
    },
    "build-storybook": {
      "dependsOn": ["@ks-digital/designsystem-themes:build"],
      "outputs": ["{projectRoot}/{options.output-dir}"],
      "options": {
        "config-dir": ".storybook",
        "output-dir": "../../dist/storybook/@ks-digital/www"
      },
      "configurations": {
        "ci": {
          "args": ["--quiet"]
        }
      }
    },
    "assemble-storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/storybook/assemble.mjs"
      }
    },
    "static-storybook": {
      "executor": "@nx/web:file-server",
      "dependsOn": ["assemble-storybook"],
      "options": {
        "buildTarget": "www:assemble-storybook",
        "staticFilePath": "dist/storybook/@ks-digital/assembled",
        "spa": false
      },
      "configurations": {
        "ci": {
          "buildTarget": "www:build-storybook:ci"
        }
      }
    }
  }
}
